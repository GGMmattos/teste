		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Tbl_relacionados = calculated
		mode: import
		source =
				
				SELECTCOLUMNS (                                      // Projeta/seleciona apenas colunas específicas para a tabela final
				    ADDCOLUMNS (                                     // Adiciona colunas calculadas à tabela base 'tbl_vinculados_todas_issues'
				        'tbl_vinculados_todas_issues',               // Tabela base contendo os vínculos (chave e tipo/direção do link)
				        "Resumo_Linked",                             // ---- A partir daqui, criamos cada coluna *Linked* via LOOKUPVALUE
				            LOOKUPVALUE (                            // Busca o Resumo da issue vinculada na tabela de subtarefas
				                'tbl_todas_issues_jira_subtarefa'[Resumo],           // Coluna de retorno (valor que queremos)
				                'tbl_todas_issues_jira_subtarefa'[Chave],            // Coluna de busca na tabela de referência
				                'tbl_vinculados_todas_issues'[Linked Issues: Key]    // Valor da chave vinculada na tabela base
				            ),
				        "Criado_linked",                             // Data de criação da issue vinculada
				            LOOKUPVALUE (
				                'Tbl_todas_issues_jira_subtarefa'[Criado],
				                'tbl_todas_issues_jira_subtarefa'[Chave],
				                'tbl_vinculados_todas_issues'[Linked Issues: Key]
				            ),
				        "Situação_linked",                           // Status atual da issue vinculada
				            LOOKUPVALUE (
				                'Tbl_todas_issues_jira_subtarefa'[Current Status],
				                'tbl_todas_issues_jira_subtarefa'[Chave],
				                'tbl_vinculados_todas_issues'[Linked Issues: Key]
				            ),
				        "Responsavel_linked",                        // Responsável atual da issue vinculada
				            LOOKUPVALUE (
				                'Tbl_todas_issues_jira_subtarefa'[Current Assignee:  Name],
				                'tbl_todas_issues_jira_subtarefa'[Chave],
				                'tbl_vinculados_todas_issues'[Linked Issues: Key]
				            ),
				        "Time_linked",                               // Time associado à issue vinculada
				            LOOKUPVALUE (
				                'Tbl_todas_issues_jira_subtarefa'[Team],
				                'tbl_todas_issues_jira_subtarefa'[Chave],
				                'tbl_vinculados_todas_issues'[Linked Issues: Key]
				            ),
				        "Projeto_linked",                            // Projeto da issue vinculada
				            LOOKUPVALUE (
				                'Tbl_todas_issues_jira_subtarefa'[Project Name],
				                'tbl_todas_issues_jira_subtarefa'[Chave],
				                'tbl_vinculados_todas_issues'[Linked Issues: Key]
				            ),
				        "Data_limite_linked",                        // Due date da issue vinculada
				            LOOKUPVALUE (
				                'Tbl_todas_issues_jira_subtarefa'[Data limite],
				                'tbl_todas_issues_jira_subtarefa'[Chave],
				                'tbl_vinculados_todas_issues'[Linked Issues: Key]
				            ),
				        "Data_atualização_linked",                   // Data de última atualização da issue vinculada
				            LOOKUPVALUE (
				                'Tbl_todas_issues_jira_subtarefa'[Atualizado(a)],
				                'tbl_todas_issues_jira_subtarefa'[Chave],
				                'tbl_vinculados_todas_issues'[Linked Issues: Key]
				            ),
				        "Data_conclusão_linked",                     // Data de conclusão/solução da issue vinculada
				            LOOKUPVALUE (
				                'Tbl_todas_issues_jira_subtarefa'[Data solução],
				                'tbl_todas_issues_jira_subtarefa'[Chave],
				                'tbl_vinculados_todas_issues'[Linked Issues: Key]
				            ),
				        "Cliente_linked",                            // Cliente associado à issue vinculada
				            LOOKUPVALUE (
				                'Tbl_todas_issues_jira_subtarefa'[Nome Cliente (Contr_ Horas)],
				                'tbl_todas_issues_jira_subtarefa'[Chave],
				                'tbl_vinculados_todas_issues'[Linked Issues: Key]
				            ),
				        "Dias_corridos_linked",                      // Métrica de dias corridos na issue vinculada
				            LOOKUPVALUE (
				                'Tbl_todas_issues_jira_subtarefa'[Dias_corridos_todas_issues_subtarefa],
				                'tbl_todas_issues_jira_subtarefa'[Chave],
				                'tbl_vinculados_todas_issues'[Linked Issues: Key]
				            ),
				        "Dias_em_atraso_linked",                     // Métrica de dias em atraso da issue vinculada
				            LOOKUPVALUE (
				                'Tbl_todas_issues_jira_subtarefa'[Dias_em_atrasos],
				                'tbl_todas_issues_jira_subtarefa'[Chave],
				                'tbl_vinculados_todas_issues'[Linked Issues: Key]
				            ),
				        "Prioridade_linked",                         // Prioridade da issue vinculada
				            LOOKUPVALUE (
				                'Tbl_todas_issues_jira_subtarefa'[Prioridade],
				                'tbl_todas_issues_jira_subtarefa'[Chave],
				                'tbl_vinculados_todas_issues'[Linked Issues: Key]
				            ),
				        "Data_inicio_linked",                        // Data de início da issue vinculada
				            LOOKUPVALUE (
				                'Tbl_todas_issues_jira_subtarefa'[Start date],
				                'tbl_todas_issues_jira_subtarefa'[Chave],
				                'tbl_vinculados_todas_issues'[Linked Issues: Key]
				            ),
				        "Agrupamento_status_linked",                 // Agrupamento de status customizado da issue vinculada
				            LOOKUPVALUE (
				                'Tbl_todas_issues_jira_subtarefa'[Relacionado_agrupamento_status_sa_entrega],
				                'tbl_todas_issues_jira_subtarefa'[Chave],
				                'tbl_vinculados_todas_issues'[Linked Issues: Key]
				            )
				    ),
				    "Chave", 'tbl_vinculados_todas_issues'[Chave],                           // Chave da issue original (não a vinculada)
				    "Linked Issues Key", 'tbl_vinculados_todas_issues'[Linked Issues: Key],  // Chave da issue vinculada (usada nas buscas)
				    "Resumo_Linked", [Resumo_Linked],                                         // Projeta a coluna calculada correspondente
				    "Cliente_Linked", [Cliente_linked],                                       // —
				    "Situação_Linked", [Situação_linked],                                     // —
				    "Data_limite_Linked", [Data_limite_linked],                               // —
				    "Responsável_Linked", [Responsavel_linked],                               // —
				    "Criado_linked", [Criado_linked],                                         // —
				    "Atualizado_linked", [Data_atualização_linked],                           // —
				    "Concluído_linked", [Data_conclusão_linked],                              // —
				    "Time_linked", [Time_linked],                                             // —
				    "Projeto", [Projeto_linked],                                              // Nome do projeto da issue vinculada
				    "Dias_em_atraso", [Dias_em_atraso_linked],                                // —
				    "Dias_corridos_linked", [Dias_corridos_linked],                           // —
				    "Prioridade_linked", [Prioridade_linked],                                 // —
				    "Start_date_linked", [Data_inicio_linked],                                // —
				    "Agrupamento_status", [Agrupamento_status_linked],                        // —
				    "Link Type", 'tbl_vinculados_todas_issues'[Linked Issues: Link Type],     // Tipo do vínculo (e.g., "blocks", "relates to", etc.)
				    "Direction", 'tbl_vinculados_todas_issues'[Linked Issues: Link Direction] // Direção do vínculo (in/out)
				)

	annotation PBI_Id = b40cbf043abe48bfbdf6c18d34b8d00a

