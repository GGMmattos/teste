table Tbl_relacionados
	lineageTag: 967207e0-7863-416a-952e-3767573476fc

	measure Dias_excedidos_label = ```
			
			VAR DataLimite = MIN(Tbl_relacionados[Data_limite_Linked])           -- ajuste a coluna/tabela se necessário
			VAR DataSolucao = MIN(Tbl_relacionados[Concluído_linked])       -- pode ser em branco
			VAR DataFinal = COALESCE(DataSolucao, TODAY())
			VAR Diff = 
			    IF(
			        ISBLANK(DataLimite),
			        BLANK(),
			        DATEDIFF(DataFinal, DataLimite, DAY)   -- Diff > 0 => ainda falta (adiantado) ; Diff < 0 => passou (atrasado)
			    )
			VAR AbsDiff = IF(ISBLANK(Diff), BLANK(), ABS(Diff))
			RETURN
			IF(
			    ISBLANK(Diff),
			    BLANK(),
			    (IF(Diff > 0, "+", IF(Diff < 0, "-", ""))) &
			    FORMAT(AbsDiff, "0") &
			    " dia" & IF(AbsDiff <> 1, "s", "")
			)
			
			```
		lineageTag: e25c74de-bdc0-43d6-ad86-1cdf8122289d

	measure Relacionado_Qtd_entrega_status_concluido = ```
			
			        CALCULATE(
			            DISTINCTCOUNT(Tbl_relacionados[Chave]),
			            Tbl_relacionados[Agrupamento_status] = "Concluído",
			            Tbl_todas_issues_jira_subtarefa[Project Name] = "PRC - Programa de Relacionamento com o Cliente") + 0
			```
		formatString: 0
		displayFolder: Tela PRC Diagnóstico
		lineageTag: 23552a7f-7619-4de4-b95a-79282415dee3

