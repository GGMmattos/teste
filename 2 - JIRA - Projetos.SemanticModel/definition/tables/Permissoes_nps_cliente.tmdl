			    LOOKUPVALUE(
			        Permissoes_nps_cliente[PodeVerValor],
			        Permissoes_nps_cliente[Usuario],
			        UsuarioLogado
			    )
			RETURN
			IF (
			    Permissao = "Sim",
			    SELECTEDVALUE(tbl_pesquisa_satisfacao[avaliacaoExecutorComentario]),
			    "Bloqueado"
			)
		lineageTag: 4a57ec4a-ce92-4b9b-b530-4722727c2c2c

