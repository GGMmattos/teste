table Permissoes_nps_cliente
	lineageTag: 9226d120-de9a-4088-94ed-1b1659ec66f6

	measure Bloqueado_media_atendimento_pesquisa =
			
			VAR UsuarioLogado = USERPRINCIPALNAME()
			VAR Permissao =
			    LOOKUPVALUE(
			        Permissoes_nps_cliente[PodeVerValor],
			        Permissoes_nps_cliente[Usuario],
			        UsuarioLogado
			    )
			VAR Resultado = 'tbl_pesquisa_satisfacao'[Media_atendimento_Respondido]
			RETURN
			IF (
			    Permissao = "Sim",
			    FORMAT(Resultado, "0.00"),   -- sempre texto
			    "Bloqueado"
			)
		lineageTag: aebfdcfd-5b67-4bdf-9ce2-710898f2188b

	measure Bloqueado_comentario_atendimento_pesquisa =
			
			VAR UsuarioLogado = USERPRINCIPALNAME()
