table fOrçamento
	lineageTag: 34a4cd74-9a9a-4425-af5c-7fce350a2387

	measure 'Soma Hrs Orçadas' = ```
			
			 // Soma das horas orçadas, porém, faz uma média de todos os valores, para não somar valores duplicados.
			SUMX(
			VALUES(tbl_entregas_jira[Chave]),
			CALCULATE(DISTINCT('fOrçamento'[totalOrcado]))
			) + 0
			```
		lineageTag: 9d1d587e-7d13-4fbb-b23e-017ef541ea56

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qtd tarefas Orçamento Aprovado' = ```
			
			        CALCULATE(        
			        DISTINCTCOUNT('fOrçamento'[issueJira.key]),
			        FILTER('fOrçamento', 'fOrçamento'[Status Orçamento] = "Aprovado")) + 0
			```
		formatString: 0
		lineageTag: e9614e21-3751-4491-aa16-e1a6a027a2de

	measure 'Qtd tarefas Orçamento Não Aprovado' = ```
			
			        CALCULATE(        
			        DISTINCTCOUNT('fOrçamento'[issueJira.key]),
			        FILTER('fOrçamento', 'fOrçamento'[Status Orçamento] = "Não aprovado")) + 0
			```
		formatString: 0
		lineageTag: 4e8ad964-c77e-400b-b13c-b95ca68fd693

	measure 'Qtd tarefas Orçamento Em Orçamento' = ```
			
			        CALCULATE(        
			        DISTINCTCOUNT('fOrçamento'[issueJira.key]),
			        FILTER('fOrçamento', 'fOrçamento'[Status Orçamento] = "Em Orçamento")) + 0
			```
		formatString: 0
		lineageTag: 18271b4a-228b-454f-baa3-eb2425e5c623

	measure 'Qtd tarefas Orçamento Cobrança/Cobrado' = ```
			
			        CALCULATE(        
			        DISTINCTCOUNT('fOrçamento'[issueJira.key]),
			        FILTER('fOrçamento', 'fOrçamento'[Status Orçamento] = "Cobrança/Cobrado")) + 0
			```
		formatString: 0
		lineageTag: 87313d71-1354-495a-955a-2276d13e5335

	measure 'Hrs. Orçadas igual (0) pegar Hrs previstas' =
			
			SWITCH(
			    TRUE(),
			    [Hrs. Orçadas com tratamento] = 0, [hrs_previstas_fApontamento_Extrato],
			    [Hrs. Orçadas com tratamento] > 0, [Hrs. Orçadas com tratamento])
		lineageTag: 02766f19-fda0-479f-be7f-c71223f7486f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Soma_horas_alto_nivel = ```
			SUM('fOrçamento'[horas.horasAltoNivel]) + 0 
			```
		formatString: #,0.00
		lineageTag: ffcd0afb-a24b-4b01-b33c-26cfac059f05

	measure 'Hrs. Previsas/Alto Nível' =
			
			// Quando as horas previstas da Entrega estiver igual a 0, será pego as horas de alto nível do controle de horas.
			                            SWITCH(
			                                TRUE(),
			                                    [hrs_previstas_fApontamento_Extrato] > 0, [hrs_previstas_fApontamento_Extrato],
			                                    [hrs_previstas_fApontamento_Extrato] >= 0, [Soma_horas_alto_nivel]) + 0
		formatString: #,0.00
		displayFolder: Tela (Comitê Produto)
		lineageTag: dc2312d0-fbe9-4baa-aa25-ac54344445bc

	measure Backlog_dias_Por_Recurso = ```
			
			FORMAT(
			    DIVIDE(
			        [Soma_horas_alto_nivel],
			        [Qtd de Recursos] * 6.5,
			        0
			    ),
			    "#,##0.00"
			) & " dias"
			
			```
		displayFolder: Tela (Comitê Produto)
		lineageTag: 1d41da89-0374-47dc-8f16-a18da8a0a143

	measure 'Hrs. Orçadas com tratamento' = ```
			
			    SUMX(
			    VALUES('fOrçamento'[issueJira.key]),
			    CALCULATE(
			    AVERAGE('fOrçamento'[totalOrcado])))
			```
		lineageTag: 6480f1f7-1a11-486d-99a6-ed69a374cb68

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qtd de Usuário' = ```
			COUNT('fOrçamento'[usuario.nome]) + 0 
			```
		formatString: 0
		lineageTag: 8fed958a-90cb-4f2c-ae5f-4d5629d38446

	measure 'Qtd de Recursos' = DISTINCTCOUNT('tblAdministração'[membros.nome]) + 0
		formatString: 0
		displayFolder: Tela (Comitê Produto)
		lineageTag: 16591691-932b-4073-97b4-9ad4104eda72

	measure 'Horas Realizadas (com relacionamento)' =
			
			CALCULATE(
			    SUM(fApontamento_Extrato[hrRealizada]),
			    USERELATIONSHIP(
			        'fOrçamento'[issueJira.filhos.key],
			        fApontamento_Extrato[chave]
			    )
			)
		lineageTag: 96ae456e-9c50-4950-8178-53e48271b958

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure recursos_disponiveis_por_dia_comite_produto =
			
			-- Quantidade de recursos disponível por papel, multiplicado por 6,5 dias.
			FORMAT([Qtd de Recursos] * 6.5, "#,##0.00") & " dias"
		displayFolder: Tela (Comitê Produto)
		lineageTag: f067a88a-6615-4b13-8b8b-e06aff99bb9f

	measure qtd_entregas_orcamento = DISTINCTCOUNT('fOrçamento'[issueJira.key]) + 0
		formatString: 0
		lineageTag: 169ee32d-dddb-4fb7-a598-b25010d99541

	measure %_Markup =
			
			AVERAGEX (
			    VALUES ( 'fOrçamento'[issueJira.key] ),
			    CALCULATE ( AVERAGE ( 'fOrçamento'[markup] ) )
			) + 0
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 38e177ff-7909-4769-b096-14471f59df66

	measure Hrs_Orcadas_Com_Markup =
			
			'fOrçamento'[Hrs. Orçadas igual (0) pegar Hrs previstas] *(1 + 'fOrçamento'[%_Markup]) + 0
		lineageTag: bc2e73e7-82b5-4ff0-adcd-5abbc3867fba

		annotation PBI_FormatHint = {"isGeneralNumber":true}

