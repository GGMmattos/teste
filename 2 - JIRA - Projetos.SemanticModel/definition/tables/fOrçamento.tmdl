	column markup
		dataType: double
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e1e2fb5a-6a26-492d-90cf-c560b9512266
		summarizeBy: none
		sourceColumn: markup

		annotation SummarizationSetBy = User

	partition fOrçamento = m
		mode: import
		source =
				let
				    Fonte = Json.Document(
				    Web.Contents(
				        "https://service.sabium.com.br/api_controlehoras/controle-publico/orcamento/buscaLista",
				        [Timeout = #duration(0,0,5,0)]
				    )
