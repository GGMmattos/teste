	column 'Status Orçamento' =
			SWITCH(
			                    TRUE(),
			                    'fOrçamento'[situacao.orçamento] = "Aprovado", "Aprovado",
			                    'fOrçamento'[situacao.orçamento] = "Não aprovado", "Não aprovado",
			                    'fOrçamento'[situacao.orçamento] IN {"Em estimativa", "Aprovar orçamento", "Em Autenticação Comercial", "Em orçamento", "Em Autenticação Técnica"}, "Em Orçamento",
			                    'fOrçamento'[situacao.orçamento] IN {"Validar cobrança", "Cobrado", "A Cobrar"}, "Cobrança/Cobrado", "Não Cobrado")
		lineageTag: 8a32aa78-372c-4946-99c2-50099fc49505
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

