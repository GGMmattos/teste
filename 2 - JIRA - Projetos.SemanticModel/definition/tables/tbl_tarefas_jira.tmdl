	column Status_tarefas_com_ou_sem_prazo_novo = ```
			
			-- utilizo na tela do Gantt
			SWITCH(
			    TRUE(),
			    -- Se a situação for Concluída ou Cancelada
			    tbl_tarefas_jira[Situacao] IN {"Concluído", "Cancelada"}, 
			        BLANK(),
			
			    -- Se não tiver data limite
			    ISBLANK(tbl_tarefas_jira[Data limite]), 
			        "Sem prazo",
			
			    -- Se a data limite já passou
			    tbl_tarefas_jira[Data limite] < TODAY(), 
			        "Atrasado",
			
			    -- Caso contrário
			    "No prazo"
			)
			
			```
		lineageTag: e1795325-65c0-4520-a0a1-54492645c01c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

