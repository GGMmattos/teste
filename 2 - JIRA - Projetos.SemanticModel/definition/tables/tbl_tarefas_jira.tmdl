			    tbl_tarefas_jira[Situacao] = "Para execução", "B0 - Para execução",
			    tbl_tarefas_jira[Situacao] = "Para avaliação", "B1 - Para avaliação",
			    tbl_tarefas_jira[Situacao] = "Em andamento", "B2 - Para andamento",
