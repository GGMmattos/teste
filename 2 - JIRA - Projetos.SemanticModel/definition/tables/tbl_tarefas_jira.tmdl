	column Criado
		dataType: dateTime
		formatString: Short Date
		lineageTag: 27baccac-653a-4b19-8bcb-1a231c44c997
		summarizeBy: none
		sourceColumn: Criado

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Extracao_data_criado_x_solucao_tarefas =
			
			// Extração de data da coluna Criado x Data Solução do Jira.
			    DATEDIFF(
			    tbl_tarefas_jira[Criado],
			    COALESCE(tbl_tarefas_jira[Data solução], TODAY() ),DAY) + 0
		formatString: 0
		lineageTag: 4585619a-dc98-4957-b4e9-152ecc662f9b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Intervalo_Dias_Criado_Solucao = ```
			
			
			SWITCH(
			    TRUE(),
			    'tbl_tarefas_jira'[Extracao_data_criado_x_solucao_tarefas] <= 15, "A) Até 15 dias",
			    'tbl_tarefas_jira'[Extracao_data_criado_x_solucao_tarefas] <= 30, "B) De 15 à 30 dias",
			    'tbl_tarefas_jira'[Extracao_data_criado_x_solucao_tarefas] <= 60, "C) De 30 à 60 dias",
			    'tbl_tarefas_jira'[Extracao_data_criado_x_solucao_tarefas] <= 90, "D) De 60 à 90 dias",
			    "F) Acima de 90 dias"
			)
			
			```
		lineageTag: 4e8e8feb-ba15-4864-ba70-c2449b4c1b5d
		summarizeBy: none

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column Ordem_Intervalo_Dias = ```
			
			VAR Dias = DATEDIFF(
			    'tbl_tarefas_jira'[Extracao_data_criado_x_solucao_tarefas],
			    TODAY(),
			    DAY
			)
			RETURN
			SWITCH(
			    TRUE(),
			    Dias <= 15, 1,
			    Dias <= 30, 2,
			    Dias <= 60, 3,
			    Dias <= 90, 4,
			    5
			)
			
			```
		formatString: 0
		lineageTag: 1eff7962-0025-4f24-8d9b-60f7ec66347b
		summarizeBy: none

		annotation SummarizationSetBy = User

	column Status_prazo_entrega_suporte = ```
			
			SWITCH(
			    TRUE(),
			    tbl_tarefas_jira[Extracao_data_criado_x_solucao_tarefas] <= 5 && tbl_tarefas_jira[Tipo de item] = "Suporte Contratual", 
			    "No prazo",
			    "Atrasado")
			```
		displayFolder: Tela Entrega Suporte
		lineageTag: 7545b6c0-e72d-4e24-8dfd-a00ba514a74a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

