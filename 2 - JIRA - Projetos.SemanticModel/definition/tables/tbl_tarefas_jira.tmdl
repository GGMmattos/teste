	column Status_prazo_manutencao = ```
			
			SWITCH(
			    TRUE(),
			    
			    // Prioridade Alta ou Muito Alta
			    tbl_tarefas_jira[Prioridade] IN {"Alta", "Muito Alta"} &&
			    tbl_tarefas_jira[Extracao_data_criado_x_solucao_tarefas] <= 3, "No prazo",
			
			    // Prioridade Média
			    tbl_tarefas_jira[Prioridade] = "Média" &&
			    tbl_tarefas_jira[Extracao_data_criado_x_solucao_tarefas] <= 7, "No prazo",
			
			    // Prioridade Baixa
			    tbl_tarefas_jira[Prioridade] IN {"Baixa", "Sem prioridade"} &&
			    tbl_tarefas_jira[Extracao_data_criado_x_solucao_tarefas] <= 15, "No prazo",
			
			    // Caso contrário
			    "Atrasado"
			)
			```
		displayFolder: Tela Entrega Manutenção
		lineageTag: 2c0f4a03-289c-49f4-b9d9-5bbe781602f8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

