			        VALUES('tbl_tarefas_jira'[Chave]),
			        7 * [Qtd_recursos_relacionado_administracao_sprint] * [Dias_Uteis_Sprint]
			    ),
			    'tbl_relacionado_administracao'[Papel Pessoas] IN {"Desenvolvedor Angular", "Desenvolvedor Delphi", "Desenvolvedor Flutter", "Desenvolvedor Java", "Desenvolvedor NodeJs"}
			) + 0
