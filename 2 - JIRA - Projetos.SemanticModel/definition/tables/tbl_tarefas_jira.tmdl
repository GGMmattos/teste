	measure Tempo_Maximo_Criacao_Conclusao =
			
			FORMAT (
			    MAXX(
			        'tbl_tarefas_jira',
			        DATEDIFF (
			            'tbl_tarefas_jira'[Criado],
			            COALESCE('tbl_tarefas_jira'[Data solução], TODAY()),
			            DAY
			        )
			    ),
			    "0"
			) & " dias"
		lineageTag: b38ff8c7-ac00-4f92-9d15-81787e708809

	measure Tempo_Medio_Criacao_Conclusao =
			
			FORMAT (
			    AVERAGEX (
