	column Dia_uteis_criado_x_fechado = NETWORKDAYS(tbl_tarefas_jira[Criado], COALESCE(tbl_tarefas_jira[Data solução],TODAY()), 1)
		formatString: 0
		lineageTag: ba977883-7907-445a-8cb8-efa02dc21969
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Status_prazo_consultoria_tecnica = ```
			
			SWITCH(
			    TRUE(),
			    'tbl_tarefas_jira'[Dia_uteis_criado_x_fechado] <= 3 
			        && 'tbl_tarefas_jira'[Tipo de item] IN {"Dúvida", "Diagnóstico"}, 
			        "No prazo",
			
			    'tbl_tarefas_jira'[Dia_uteis_criado_x_fechado] <= 5 
			        && 'tbl_tarefas_jira'[Tipo de item] IN {"Suporte Contratual"}, 
			        "No prazo",
			
			    'tbl_tarefas_jira'[Data limite] >= TODAY() 
			        && 'tbl_tarefas_jira'[Tipo de item] = "Serviço Extracontratual", 
			        "No prazo",
			    
			        'tbl_tarefas_jira'[Data limite] = BLANK()
			        && 'tbl_tarefas_jira'[Tipo de item] = "Serviço Extracontratual", 
			        "Sem prazo",
			    "Atrasado"
			)
			
			```
		displayFolder: Tela Consultoria Técnica
		lineageTag: 3406f653-2fac-4afd-be6b-85162bef7296
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Intervalo_dias_criado_x_concluido_consultoria = ```
			
			VAR Dias = 'tbl_tarefas_jira'[Extracao_data_criado_x_solucao_tarefas]
			RETURN
			SWITCH(
			    TRUE(),
			    Dias <= 3, "A) Até 3 dias",
			    Dias <= 15, "B) De 4 à 15 dias",
			    Dias <= 30, "C) De 16 à 30 dias",
			    Dias <= 60, "D) De 31 à 60 dias",
			    Dias <= 90, "E) De 61 à 90 dias",
			    "F) Acima de 90 dias"
			)
			
			```
		displayFolder: Tela Consultoria Técnica
		lineageTag: a565c8c5-8cd9-4411-affc-6fd0b1b173e8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

