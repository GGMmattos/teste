table tbl_tarefas_jira
	lineageTag: 39964472-6c29-49c7-ab8b-02162934aef9

	measure Qtd_tarefas = ```
			
			// Quantidade de tarefas do Jira. 
			DISTINCTCOUNT(tbl_tarefas_jira[Chave]) + 0
			```
		formatString: #,0
		lineageTag: b76b8bfa-2b08-4634-8432-d5d704903cff

	measure Qtd_tarefas_suporte_contratual =
			
			CALCULATE(
			DISTINCTCOUNT(tbl_tarefas_jira[Chave]),
			tbl_tarefas_jira[Tipo de item] = "Suporte Contratual") + 0
		formatString: #,0
		displayFolder: Tela Entrega Suporte
		lineageTag: caf5c380-d5ee-4db5-bf73-d5f6f0423ef6

	measure Qtd_tarefas_concluidas_e_canceladas = ```
			
			        CALCULATE(
			            DISTINCTCOUNT(tbl_tarefas_jira[Chave]),
			            tbl_tarefas_jira[Situacao] IN {"Concluído", "Cancelada"}) + 0
			```
		formatString: #,0
		lineageTag: cd2b30f7-4c3b-472e-b416-65eff46f30b8

	measure Acumulado_tarefas_criadas_novo = ```
			
			// Total acumulado de tarefas criadas, usando como base a tabela de data auxiliar. 
			CALCULATE(
			    tbl_tarefas_jira[Qtd_tarefas],
			    FILTER(
			        ALLSELECTED('Calendario_automatico_novo'),
			        'Calendario_automatico_novo'[Date] <= MAX('Calendario_automatico_novo'[Date])
			    )
			)
			```
		formatString: 0
		lineageTag: 0aa089c5-e438-4a9f-b83f-2e9a6b6ff971

	measure Acumulado_tarefas_concluidas_novo = ```
			
			// Total acumulado de tarefas já concluidas, usando como base a tabela de data auxiliar. 
			CALCULATE(
			    [Qtd_tarefa_concluida_via_relacionamento_novo],
			    FILTER(
			        ALLSELECTED('Calendario_automatico_novo'),
			        'Calendario_automatico_novo'[Date] <= MAX('Calendario_automatico_novo'[Date])
			    )
			)
			```
		formatString: 0
		lineageTag: 01ab9749-b2ab-40aa-887d-69bba84e4503

	measure Acumulado_tarefas_em_aberto_novo = tbl_tarefas_jira[Acumulado_tarefas_criadas_novo] - [Acumulado_tarefas_concluidas_novo]
		formatString: 0
		lineageTag: 6fcd3991-3182-45e5-b83b-ec49c32c6248

