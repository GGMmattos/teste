	measure Dias_Uteis_Restantes_sprint =
			
			VAR Hoje   = TODAY()
			VAR Inicio = MAX ( 'tbl_tarefas_jira'[Current Sprint Start Date] )
			VAR Fim    = MAX ( 'tbl_tarefas_jira'[Current Sprint End Date] )
			VAR InicioContagem = MAX ( Hoje, Inicio )          -- se a sprint for futura, começa no início da sprint
			RETURN
			IF (
			    Hoje > Fim,
			    0,                                            -- sprint já terminou
			    CALCULATE (
			        COUNTROWS ( FILTER ( Calendario_dias_uteis, Calendario_dias_uteis[Dia_Util] = 1 ) ),
			        Calendario_dias_uteis[Date] >= InicioContagem,
			        Calendario_dias_uteis[Date] <= Fim
			    )
			)
		formatString: 0
		displayFolder: Sprint (tarefas)
		lineageTag: a7f93f9d-ed8c-4d5c-b5af-d996aa229f0d

	measure Projetado_recurso_desenv_sprint =
			
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE(tbl_tarefas_jira[Current Sprint State]) = "Futura",
			        (tbl_tarefas_jira[hrs_previsao_recurso_desenv]),
			    -- Senão (qualquer outra situação)
			        7 * [Qtd_recursos_desenv_relacionado_administracao_sprint] * [Dias_Uteis_Restantes_sprint]
			)
		formatString: #,0.00
		displayFolder: Sprint (tarefas)
		lineageTag: d0ce212f-75ff-4402-86b6-9f3fe26f986a

	measure Hrs_projetadas_desenv_sprint = ```
			
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE(tbl_tarefas_jira[Current Sprint State]) = "Futura",
			        ([hrs_previstas_sprint_desenv]),
			    -- Senão (qualquer outra situação)
			        'fApontamento_Extrato'[hrs_previstas_fApontamento_Extrato] - fApontamento_Extrato[Soma Hrs Realizado Tarefa e Subtarefa (Tela Desvios)] + 0
			)
			
			```
		formatString: #,0.00
		displayFolder: Sprint (tarefas)
		lineageTag: 29b060eb-1e21-4bdd-9890-c64c84f7845f

	measure %_alocacao_projetado_desenv = DIVIDE([Hrs_projetadas_desenv_sprint], [Projetado_recurso_desenv_sprint]) + 0
		formatString: #,0.00%;-#,0.00%;#,0.00%
		displayFolder: Sprint (tarefas)
		lineageTag: d79af59a-f8d2-4244-852e-5c6a5854ca71

	measure Dias_Uteis_Sprint =
			
			VAR DataInicio = MIN(tbl_tarefas_jira[Current Sprint Start Date])
			VAR DataFim    = MAX(tbl_tarefas_jira[Current Sprint End Date])
			RETURN
			    CALCULATE (
			        COUNTROWS ( 'Calendario_dias_uteis' ),
			        'Calendario_dias_uteis'[Dia_Util] = 1,
			        'Calendario_dias_uteis'[Date] >= DataInicio,
			        'Calendario_dias_uteis'[Date] <= DataFim
			    ) - 1
		formatString: 0
		displayFolder: Sprint (tarefas)
		lineageTag: 4b8d2695-21f5-4634-9567-ecff50cdb354

