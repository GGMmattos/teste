	column Classificacao_nps_solucao =
			
			SWITCH(
			    TRUE(),
			    tbl_pesquisa_satisfacao[avaliacaoSolucao] >= 9, "Promotor",
			    tbl_pesquisa_satisfacao[avaliacaoSolucao] >= 7, "Neutro",
			    tbl_pesquisa_satisfacao[avaliacaoSolucao] = 0, "Sem Resposta",
			    "Detrator"
			)
		displayFolder: NPS Solução
		lineageTag: 03cffffa-419b-413b-8639-c0ca660c7337
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Status_respostas_pesquisa = ```
			
			    SWITCH(
			        TRUE(),
			        tbl_pesquisa_satisfacao[idUsuarioResposta] > 0, "Respondido", "Não respondido")
			```
		lineageTag: d9589fb4-030f-466c-8c73-a8bbdbf8fd7b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

