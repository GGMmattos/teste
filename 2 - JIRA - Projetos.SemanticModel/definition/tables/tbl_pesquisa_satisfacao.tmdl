table tbl_pesquisa_satisfacao
	lineageTag: a4be0031-a287-49ba-a7f8-a30ccc45c32a

	measure Qtd_nps_respondido_atendimento =
			
			CALCULATE(
			    DISTINCTCOUNT(tbl_pesquisa_satisfacao[ticket]),
			    tbl_pesquisa_satisfacao[avaliacaoExecutor] <> 0) + 0
		formatString: 0
		displayFolder: NPS Atendimento
		lineageTag: 958e11a1-e48b-43fd-9dea-206bf4168a10

	measure Qtd_nps_nao_respondido_atendimento =
			
			CALCULATE(
			    DISTINCTCOUNT(tbl_pesquisa_satisfacao[ticket]),
			    tbl_pesquisa_satisfacao[avaliacaoExecutor] = 0) + 0
		formatString: 0
		displayFolder: NPS Atendimento
		lineageTag: d9269188-f99f-40a7-b5e5-3518edeb895f

	measure Media_atendimento_Respondido =
			
			CALCULATE (
			    AVERAGE ( tbl_pesquisa_satisfacao[avaliacaoExecutor] ),
			    tbl_pesquisa_satisfacao[Status_respostas_pesquisa] = "Respondido"
			) + 0
		formatString: 0
		displayFolder: NPS Atendimento
		lineageTag: 14a114a7-bd9f-4031-9983-441e6ee0dc22

		annotation PBI_FormatHint = {"isDecimal":true}

	measure Media_solucao_Respondido =
			
			CALCULATE (
			    AVERAGE ( tbl_pesquisa_satisfacao[avaliacaoSolucao] ),
			    tbl_pesquisa_satisfacao[Status_respostas_pesquisa] = "Respondido"
			) + 0
		displayFolder: NPS Solução
		lineageTag: 694844a4-84a2-4b8e-b23e-b080a6d715ef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Qtd_nps_promotor_solucao = ```
			
			    CALCULATE(
			        DISTINCTCOUNT(tbl_pesquisa_satisfacao[ticket]),
			        tbl_pesquisa_satisfacao[Classificacao_nps_solucao] = "Promotor") + 0
			```
		formatString: 0
		displayFolder: NPS Solução
		lineageTag: 353d614b-b7ed-4c95-8780-10228a57d67b

	measure Qtd_nps_detrator_solucao = ```
			
			    CALCULATE(
			        DISTINCTCOUNT(tbl_pesquisa_satisfacao[ticket]),
			        tbl_pesquisa_satisfacao[Classificacao_nps_solucao] = "Detrator",
			        tbl_pesquisa_satisfacao[avaliacaoSolucao] <> 0) + 0
			```
		formatString: 0
		displayFolder: NPS Solução
		lineageTag: 6a7b1b85-3428-478f-bf43-5e8d5326b3ae

	measure %_media_nps_solucao = [%_media_promotor_solucao] - [%_media_detrator_solucao]
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: NPS Solução
		lineageTag: 464e4f8e-48cf-4672-8fca-391718563689

	measure %_media_detrator_solucao = DIVIDE([Qtd_nps_detrator_solucao], [Qtd_nps_respondido_solucao]) + 0
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: NPS Solução
		lineageTag: da457df2-7e1a-4faa-adf5-c5f7daeadf62

	measure Qtd_nps_respondido_solucao =
			
			CALCULATE(
			    DISTINCTCOUNT(tbl_pesquisa_satisfacao[ticket]),
			    tbl_pesquisa_satisfacao[avaliacaoSolucao] <> 0) + 0
		formatString: 0
		displayFolder: NPS Solução
		lineageTag: f2d002e5-7746-4eb1-9808-00884c2dc17f

	measure %_media_promotor_solucao = DIVIDE([Qtd_nps_promotor_solucao], [Qtd_nps_respondido_solucao]) + 0
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: NPS Solução
		lineageTag: 049b397e-a446-4799-9faa-306cb0525ca0

	measure Qtd_pesquisa =
			
			CALCULATE(
			DISTINCTCOUNT(tbl_pesquisa_satisfacao[ticket]),
			 tbl_pesquisa_satisfacao[dataConclusao] <> BLANK()) + 0
		formatString: 0
		lineageTag: 2c3cdd28-d495-4046-9ba5-7d3aa8f75d6d

	measure Qtd_pesquisa_nao_respondida = ```
			
			    CALCULATE(
			        DISTINCTCOUNT(tbl_pesquisa_satisfacao[ticket]),
			        tbl_pesquisa_satisfacao[avaliacaoExecutor] = 0,
			        tbl_pesquisa_satisfacao[dataConclusao] <> BLANK()) + 0
			```
		formatString: 0
		lineageTag: 674b75a9-6afc-45a5-a507-19b6c4e2a8ae

	measure %_adesao_pesquisa = DIVIDE([Qtd_nps_respondido_atendimento], [Qtd_pesquisa])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e0b79a0d-881f-4761-99b6-603356865bc3

	measure %_pesquisa_nao_respondida = DIVIDE([Qtd_pesquisa_nao_respondida], [Qtd_pesquisa]) + 0
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 511b815c-ac64-44b7-9b60-50122f2bdbc1

	measure %_total_pesquisa = DIVIDE([Qtd_pesquisa], [Qtd_pesquisa]) + 0
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3be910ad-1d11-4025-9e5a-f44046e2de62

	measure %_Media_avaliacao_atendimento = ```
			
			CALCULATE (
			    AVERAGE ( tbl_pesquisa_satisfacao[avaliacaoExecutor] ),
			    tbl_pesquisa_satisfacao[avaliacaoExecutor] > 0
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: NPS Atendimento
		lineageTag: 0624a0ca-a154-41d1-b5ec-e10e1e18a4b5

	measure 'Média de Média de avaliacaoExecutor por ticket' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('tbl_pesquisa_satisfacao'[ticket])),
				CALCULATE(AVERAGE('tbl_pesquisa_satisfacao'[avaliacaoExecutor]))
			)
		formatString: 0
		lineageTag: d289a811-d59f-4923-b697-6bab8275595c

