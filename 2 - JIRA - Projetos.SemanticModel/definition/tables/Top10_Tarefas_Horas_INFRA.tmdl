	partition Top10_Tarefas_Horas_INFRA = calculated
		mode: import
		source = ```
				
				-- trazer as 10 tarefas com maiores apontamentos nos ultimos 30d
				
				TOPN(
				    10,
				    FILTER(
				        ADDCOLUMNS(
				            SUMMARIZE(
				                'tbl_tarefas_jira',
				                'tbl_tarefas_jira'[Chave],
				                'tbl_tarefas_jira'[Project Name],
				                'tbl_tarefas_jira'[Criado],
				                'tbl_tarefas_jira'[Responsável Tecnico:  Name],
				                'tbl_tarefas_jira'[Link_tarefa_jira_novo]
				            ),
				            "HorasRealizadas", 
				            CALCULATE(
				                'tbl_tarefas_jira'[Horas_realizadas_tarefas_e_subtarefas]
				            )
				        ),
				        'tbl_tarefas_jira'[Project Name] = "INFRA"
				        && 'tbl_tarefas_jira'[Criado] >= TODAY() - 30
				    ),
				    [HorasRealizadas],
				    DESC
				)
				
				```

	annotation PBI_Id = 08a3392227c14f91a808b10bcd348041

