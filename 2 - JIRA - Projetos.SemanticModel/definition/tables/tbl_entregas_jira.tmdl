	column Extracao_data_criado_x_solucao_entregas =
			
			// Extração de data da coluna Criado x Data Solução do Jira.
			    DATEDIFF(
			    tbl_entregas_jira[Criado],
			    COALESCE(tbl_entregas_jira[Data solução], TODAY() ),DAY) + 1
		formatString: 0
		lineageTag: aa68a610-8a30-4c01-8cb0-dd0d4c61ef71
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Link_entrega_jira_novo =
			
			"https://sabium.atlassian.net/browse/" & 'tbl_entregas_jira'[Chave]
		lineageTag: 6b8fad22-dc19-4fbe-8a2f-732d1772715f
		dataCategory: WebUrl
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Agrupamento_status_sa_entrega = ```
			
			            SWITCH(
			                TRUE(),
			                    tbl_entregas_jira[Situacao] IN {"Aberto"}, "Aberto",
			                    tbl_entregas_jira[Situacao] IN {"Backlog aceite"}, "Backlog aceite",
			                    tbl_entregas_jira[Situacao] IN {"Backlog Comitê Produto"}, "Backlog CP",
			                    tbl_entregas_jira[Situacao] = "Backlog Evolução", "Backlog Evolução",
			                    tbl_entregas_jira[Situacao] IN {"Backlog Distribuidora"}, "Backlog Distribuidora",
			                    tbl_entregas_jira[Situacao] IN {"Em andamento CP"}, "Em andamento CP",
			                    tbl_entregas_jira[Situacao] IN {"Em triagem"}, "Triagem",
			                    tbl_entregas_jira[Situacao] IN {"Em Avaliação", "Em avaliação/Diagnóstico"}, "Avaliação Consultoria",
			                    tbl_entregas_jira[Situacao] IN {"Em orçamento (Análise)"}, "Orçamento Análise",
			                    tbl_entregas_jira[Situacao] IN {"Aprovar Orçamento Análise"}, "Aprovar Orçamento (Análise)",
			                    tbl_entregas_jira[Situacao] IN {"Em análise de requisitos"}, "Em Análise",
			                    tbl_entregas_jira[Situacao] IN {"Aprovar documento"}, "Aprovar Documento",
			                    tbl_entregas_jira[Situacao] IN {"Em orçamento (Execução)"}, "Orçamento (Execução)",
			                    tbl_entregas_jira[Situacao] = "Autenticação Técnica", "Autenticação Técnica",
			                    tbl_entregas_jira[Situacao] = "Autenticação Comercial (Execução)", "Autenticação Comercial (Execução)",
			                    tbl_entregas_jira[Situacao] = "Autenticação Comercial (Análise)", "Autenticação Comercial (Análise)",
			                    tbl_entregas_jira[Situacao] IN {"Aprovar Orçamento Execução"}, "Aprovar Orçamento (Execução)",
			                    tbl_entregas_jira[Situacao] IN {"Aguardando solução"}, "Aguardando Solução",
			                    tbl_entregas_jira[Situacao] = "Desenvolvimento", "Desenvolvimento",
			                    tbl_entregas_jira[Situacao] = "Suporte/Manutenção", "Suporte/Manutenção",
			                    tbl_entregas_jira[Situacao] = "Infraestrutura", "Infraestrutura",
			                    tbl_entregas_jira[Situacao] = "Serviços Extracontratuais", "Serviços Extracontratuais",
			                    tbl_entregas_jira[Situacao] IN {"Para entrega"}, "Para Entrega",
			                    tbl_entregas_jira[Situacao] IN {"Aguardando validação cliente"}, "Validação Cliente",
			                    tbl_entregas_jira[Situacao] IN {"Em avaliação de NC"}, "Em Avaliação de NC",
			                    tbl_entregas_jira[Situacao] IN {"Aguardando cliente", "Aguardando interno", "Autorizar acesso a base de terceiros"}, "Aguardando Interno",
			                    tbl_entregas_jira[Situacao] =  "Cancelada",  "Cancelada",
			                    tbl_entregas_jira[Situacao] =  "Concluído", "Concluído")
			```
		displayFolder: Tela Analítico de Atendimento
		lineageTag: 60b7200e-8940-4f98-a688-b277705e48eb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

