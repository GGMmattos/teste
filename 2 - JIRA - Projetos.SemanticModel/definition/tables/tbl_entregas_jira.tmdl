	column Filtro_status_agrupado_inovacao = ```
			
			SWITCH(
			    TRUE(),
			    
			    -- Concluído
			    'tbl_entregas_jira'[Situacao] IN { "Concluído", "Cancelada" }, "Concluído",
			    'fApontamento_Extrato'[% Conclusão (Tela Desvios)] = 1, "Concluído",
			    
			    -- Pausado
			    'tbl_entregas_jira'[Situacao] IN { "Exibir_situacao_hierarquia_entrega_tarefa" }, "Pausado",
			    
			    -- Em andamento
			    'tbl_entregas_jira'[Situacao] = "Em andamento", "Em andamento",
			    'fApontamento_Extrato'[Soma Hrs Realizado Tarefa e Subtarefa (Tela Desvios)] > 0, "Em andamento",
			    
			    -- Aberto (padrão)
			    "Aberto"
			)
			
			```
