	partition tbl_entregas_jira = m
		mode: import
		source =
				let
				    Fonte = OData.Feed("https://bi-reports.appfire.app/aio-app/rest/aio-cn/1.0/powerbi/export/NTE0OTk4ZDItNjk5YS00NzU2LThiZTMtMDQzMzdmNmY2", null, [Implementation="2.0"]),
				    Issues_table = Fonte{[Name="Issues",Signature="table"]}[Data],
				    #"Tipo Alterado" = Table.TransformColumnTypes(Issues_table,{{"Criado", type date}, {"Data limite", type date}, {"Atualizado(a)", type date}, {"Data solução", type date}, {"Start date", type date}}),
				    #"Colocar Cada Palavra Em Maiúscula" = Table.TransformColumns(#"Tipo Alterado",{{"Nome Cliente (Contr_ Horas)", Text.Proper, type text}, {"Resumo", Text.Proper, type text}}),
				    #"Colunas Renomeadas" = Table.RenameColumns(#"Colocar Cada Palavra Em Maiúscula",{{"Current Assignee:  Name", "Responsavel"}, {"Current Status", "Situacao"}, {"Time Spent (Incl_ Sub-tasks)", "Tempo gasto (incluindo subtarefas)"}}),
				    #"Coluna Mesclada Inserida" = Table.AddColumn(#"Colunas Renomeadas", "Chave_titulo_entregas_jira", each Text.Combine({[Chave], [Resumo]}, " - "), type text),
				    #"Valor Substituído" = Table.ReplaceValue(#"Coluna Mesclada Inserida",null,"N/A",Replacer.ReplaceValue,{"Nível prioridade"}),
				    #"Tipo Alterado1" = Table.TransformColumnTypes(#"Valor Substituído",{{"Rentabilidade", Currency.Type}}),
				    #"Tipo Alterado2" = Table.TransformColumnTypes(#"Tipo Alterado1",{{"ROI", Percentage.Type}})
				in
				    #"Tipo Alterado2"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

