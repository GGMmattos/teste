	measure Qtd_Entregas_Vencidas =
			
			CALCULATE(
			    DISTINCTCOUNT(tbl_entregas_jira[Chave]),
			    tbl_entregas_jira[Data limite] < TODAY(),
			    NOT ISBLANK(tbl_entregas_jira[Data limite])
			) + 0
		formatString: #,0
		displayFolder: Tela Prioridade Atendimento
		lineageTag: 3c367467-6aa5-4d59-b698-55c930fb32c9

	measure Qtd_Entregas_Vencem_Hoje =
			
			CALCULATE(
			    DISTINCTCOUNT(tbl_entregas_jira[Chave]),
