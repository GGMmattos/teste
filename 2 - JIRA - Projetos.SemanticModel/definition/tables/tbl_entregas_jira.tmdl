	column 'Status Agrupador_errado' = ```
			
			SWITCH(
			    TRUE(),
			    
			    CALCULATE(
			        COUNTROWS(tbl_entregas_jira),
			        FILTER(
			            tbl_entregas_jira,
			            tbl_entregas_jira[Situacao] = "Concluído" ||
			            tbl_entregas_jira[Situacao] = "Cancelada" ||
			            tbl_entregas_jira[Situacao] = "Para Entrega" ||
			            tbl_entregas_jira[Situacao] = "Aguardando validação cliente"
			        )
			    ) > 0, "Concluído",
			
			    CALCULATE(
			        COUNTROWS(tbl_tarefas_jira),
			        FILTER(
			            tbl_tarefas_jira,
			            tbl_tarefas_jira[Situacao] = "Em revisão da qualidade" ||
			            tbl_tarefas_jira[Situacao] = "Aguardando versão" ||
			            tbl_tarefas_jira[Situacao] = "Versão homologação interna" ||
			            tbl_tarefas_jira[Situacao] = "Qualidade"
			        )
			    ) > 0, "Qualidade",
			
			    CALCULATE(
			        COUNTROWS(fApontamento_Extrato),
			        FILTER(
			            fApontamento_Extrato,
			            fApontamento_Extrato[hrRealizada] > 0
			        )
			    ) > 0, "Em Andamento",
			
			    "Pendente"
			)
			
			```
		lineageTag: 159f1a65-d387-4a19-a0d7-b17f82a2f7f1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

