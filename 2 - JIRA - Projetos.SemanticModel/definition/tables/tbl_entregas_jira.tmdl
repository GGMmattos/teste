	column Status_Prazo =
			
			SWITCH(
			    TRUE(),
			    ISBLANK(tbl_entregas_jira[Data limite]), "Sem Prazo de Entrega",
			    tbl_entregas_jira[Data limite] = TODAY(), "Vencem Hoje",
			    tbl_entregas_jira[Data limite] >= TODAY() + (7 - WEEKDAY(TODAY(), 2)) &&
			    tbl_entregas_jira[Data limite] <  TODAY() + (14 - WEEKDAY(TODAY(), 2)), "Vencem Semana que Vem",
			    tbl_entregas_jira[Data limite] < TODAY(), "Fora do Prazo",
			    tbl_entregas_jira[Data limite] > TODAY(), "No Prazo"
			)
		displayFolder: Tela Prioridade Atendimento
		lineageTag: d0cba35c-102a-48ee-8688-44154c97529c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

