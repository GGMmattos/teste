	measure Qtd_Entregas_Vencem_Semana_Que_Vem =
			
			CALCULATE(
			    DISTINCTCOUNT(tbl_entregas_jira[Chave]),
			    FILTER(
			        tbl_entregas_jira,
			        tbl_entregas_jira[Data limite] >= TODAY() + (7 - WEEKDAY(TODAY(), 2)) &&
			        tbl_entregas_jira[Data limite] <  TODAY() + (14 - WEEKDAY(TODAY(), 2))
			    )
			) + 0
		formatString: #,0
		displayFolder: Tela Prioridade Atendimento
		lineageTag: 79f31993-7e44-4baa-9986-d9b5ed724bf0

