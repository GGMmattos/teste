	measure Acumulado_entregas_concluidas = ```
			
			// Total acumulado de entregas já concluidas, usando como base a tabela de data auxiliar. 
			CALCULATE(
			    [Qtd_entrega_concluida_via_relacionamento_atendimento],
			    FILTER(
			        ALLSELECTED('Calendário SA (criado x fechado)'),
			        'Calendário SA (criado x fechado)'[Date] <= MAX('Calendário SA (criado x fechado)'[Date])
			    )
			)
			```
		formatString: 0
		lineageTag: ccb84b6e-d5d8-45c1-8b18-a4162faf1d3f

	measure Acumulado_entregas_criadas = ```
			
			// Total acumulado de entregas criadas, usando como base a tabela de data auxiliar. 
			CALCULATE(
			    DISTINCTCOUNT(tbl_entregas_jira[Chave]),
			    FILTER(
			        ALLSELECTED('Calendário SA (criado x fechado)'),
			        'Calendário SA (criado x fechado)'[Date] <= MAX('Calendário SA (criado x fechado)'[Date])
			    )
			)
			```
		formatString: 0
		lineageTag: 672deb6f-acc9-4718-b23a-efdc61cc4b5f

	measure Acumulado_entregas_em_aberto =
			
			//Tarefas que ainda estão em aberto, com base nas medidas acumuladas.
