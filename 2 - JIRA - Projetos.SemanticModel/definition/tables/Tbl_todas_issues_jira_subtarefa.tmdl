	partition Tbl_todas_issues_jira_subtarefa = calculated
		mode: import
		source = ```
				
				
				    SUMMARIZE(
				        FILTER(
				            'tbl_todas_issues_jira',
				            'tbl_todas_issues_jira'[Tipo de item] IN {"Subtarefa", "Bug Qualidade", "Bug Análise", "Bug Review", "Bug OKR", "Bug Teste", "Entrega"}
				        ),
				        'tbl_todas_issues_jira'[Chave],
				        'tbl_todas_issues_jira'[Criado],
				        'tbl_todas_issues_jira'[Data solução],
				        'tbl_todas_issues_jira'[Current Assignee:  Name],
				        'tbl_todas_issues_jira'[Current Status],
				        'tbl_todas_issues_jira'[Data limite],
				        'tbl_todas_issues_jira'[Start date],
				        'tbl_todas_issues_jira'[Nome Cliente (Contr_ Horas)],
				        'tbl_todas_issues_jira'[Tipo de Despesa],
				        'tbl_todas_issues_jira'[Setor],
				        'tbl_todas_issues_jira'[Project Name],
				        'tbl_todas_issues_jira'[Parent Issue Summary],
				        'tbl_todas_issues_jira'[Resumo],
				        'tbl_todas_issues_jira'[Custo (R$)],
				        'tbl_todas_issues_jira'[Team],
				        'tbl_todas_issues_jira'[Prioridade],
				        'tbl_todas_issues_jira'[Parent Issue Key],
				        'tbl_todas_issues_jira'[Atualizado(a)]
				    )
				```

	annotation PBI_Id = 024686ad6a10486b9e604242bc220810

