	column Dias_corridos_todas_issues_subtarefa = ```
			
			    DATEDIFF(
			    Tbl_todas_issues_jira_subtarefa[Criado],
			    COALESCE(Tbl_todas_issues_jira_subtarefa[Data solução], TODAY() ),DAY) + 0
