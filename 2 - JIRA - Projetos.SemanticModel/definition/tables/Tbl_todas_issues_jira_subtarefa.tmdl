	column Relacionado_agrupamento_status_sa_entrega = ```
			
			            SWITCH(
			                TRUE(),
			                    Tbl_todas_issues_jira_subtarefa[Current Status] IN {"Aberto"}, "Aberto",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] IN {"Backlog aceite"}, "Backlog aceite",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] IN {"Backlog Comitê Produto"}, "Backlog CP",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] = "Backlog Evolução", "Backlog Evolução",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] IN {"Backlog Distribuidora"}, "Backlog Distribuidora",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] IN {"Em andamento CP"}, "Em andamento CP",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] IN {"Em triagem"}, "Triagem",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] IN {"Em Avaliação", "Em avaliação/Diagnóstico"}, "Avaliação Consultoria",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] IN {"Em orçamento (Análise)"}, "Orçamento Análise",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] IN {"Aprovar Orçamento Análise"}, "Aprovar Orçamento (Análise)",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] IN {"Em análise de requisitos"}, "Em Análise",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] IN {"Aprovar documento"}, "Aprovar Documento",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] IN {"Em orçamento (Execução)"}, "Orçamento (Execução)",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] = "Autenticação Técnica", "Autenticação Técnica",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] = "Autenticação Comercial (Execução)", "Autenticação Comercial (Execução)",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] = "Autenticação Comercial (Análise)", "Autenticação Comercial (Análise)",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] IN {"Aprovar Orçamento Execução"}, "Aprovar Orçamento (Execução)",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] IN {"Aguardando solução"}, "Aguardando Solução",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] = "Desenvolvimento", "Desenvolvimento",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] = "Suporte/Manutenção", "Suporte/Manutenção",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] = "Infraestrutura", "Infraestrutura",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] = "Serviços Extracontratuais", "Serviços Extracontratuais",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] IN {"Para entrega"}, "Para Entrega",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] IN {"Aguardando validação cliente"}, "Validação Cliente",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] IN {"Em avaliação de NC"}, "Em Avaliação de NC",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] IN {"Aguardando cliente", "Aguardando interno", "Autorizar acesso a base de terceiros"}, "Aguardando Interno",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] =  "Cancelada",  "Cancelada",
			                    Tbl_todas_issues_jira_subtarefa[Current Status] =  "Concluído", "Concluído")
			```
		lineageTag: 8557080a-1989-4d9c-9386-db83849e3783
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Parent Issue Key'
		lineageTag: cb427dba-542f-4ac2-a2ea-05aeabf6ab6b
