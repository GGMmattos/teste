	column Tempo_projeto = ```
			
			VAR DataInicial =
			    CALCULATE(
			        MIN(tbl_start_stop_relacionado[Data Inicial]),
			        ALLEXCEPT(tbl_start_stop_relacionado, tbl_start_stop_relacionado[Projeto])
			    )
			VAR DataFinal =
			    CALCULATE(
			        MAX(tbl_start_stop_relacionado[Data Final]),
			        ALLEXCEPT(tbl_start_stop_relacionado, tbl_start_stop_relacionado[Projeto])
			    )
			RETURN
			DATEDIFF(DataInicial, DataFinal, DAY)
			
			```
