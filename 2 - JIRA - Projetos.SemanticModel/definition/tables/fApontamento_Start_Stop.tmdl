	column Data_inicial_sem_horas =
			
			DATE(YEAR(fApontamento_Start_Stop[dataInicial]), MONTH(fApontamento_Start_Stop[dataInicial]), DAY(fApontamento_Start_Stop[dataInicial]))
		formatString: Short Date
		lineageTag: 0cf57623-f3f0-42c6-860f-89346f54ac07
