	lineageTag: d44c1c10-9b0b-4f56-ad5e-595f5046ac5a

	measure 'Média Produção Realizado %' =
			
			DIVIDE([Soma Hrs Realizadas (Start/Stop)], [Soma Hrs. CLT + Coop])
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: b46daead-0701-4046-95a5-1c96f46360be

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

		changedProperty = FormatString

		changedProperty = IsHidden

	measure 'Soma Hrs Realizadas (Start/Stop)' = SUM(fApontamento_Start_Stop[duracao]) + 0
		formatString: #,0.00
		lineageTag: dd70a23b-fc2d-489b-b807-e2591557aa78

		changedProperty = IsHidden

	measure 'Real Início (Produção)' = COALESCE(MIN(fApontamento_Start_Stop[data I]), BLANK())
		formatString: General Date
		lineageTag: a27a73eb-39b4-4c76-940e-6f3971bbe820

	measure 'Média Produção limit. 100%' = ```
			
			    SWITCH(
			    TRUE(),
			    'fApontamento_Start_Stop'[Média Produção Realizado %] > 1, "100" * 10 / 1000,
			    'fApontamento_Start_Stop'[Média Produção Realizado %] < 1, 'fApontamento_Start_Stop'[Média Produção Realizado %]) + 0
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1d8c1c38-8dd4-4063-a1d3-925357529684

	measure 'Qtd tarefa Manutenção (Start/Stop)' =
			CALCULATE(
				DISTINCTCOUNT(fApontamento_Start_Stop[nomeTarefa]),
				fApontamento_Start_Stop[tipoTicket] IN { "Manutenção", "NC - Qualidade" }
			) + 0
		formatString: #,0
		displayFolder: Tela Manutenção
		lineageTag: bdd5c5c4-3779-436d-afbb-01e9d0b0c5f2

	measure 'Qtd Tarefas (Start/Stop)' = DISTINCTCOUNT(fApontamento_Start_Stop[nomeTarefa])
		formatString: #,0
