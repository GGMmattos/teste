	column 'datainicial_semana (Interação)' =
			
			"Semana " & FORMAT(WEEKNUM(fApontamento_Start_Stop[dataFinal], 2), "00")
			//WEEKNUM(fApontamento_Start_Stop[Data_inicial_sem_horas], 2)
		lineageTag: 31398596-4123-46e8-a3ae-1df008d18216
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Filtro Período (Fábrica)' =
			
			SWITCH(
			    TRUE(),
			    fApontamento_Start_Stop[dataInicial] >= TODAY() - 7 && fApontamento_Start_Stop[dataInicial] <= TODAY(), "Últimos 7 dias",
			    fApontamento_Start_Stop[dataInicial] >= TODAY() - 30 && fApontamento_Start_Stop[dataFinal] <= TODAY(), "Últimos 30 dias",
			    fApontamento_Start_Stop[dataInicial] >= TODAY() - 180, "Últimos 180 dias",
			    "Outros"
			)
		lineageTag: 5b09c95e-aad2-461e-84ce-2c31445539f8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Ajuda entre times' = LOOKUPVALUE(tblApontamento_Time[descricao], tblApontamento_Time[id], fApontamento_Start_Stop[timeTarefaId])
		lineageTag: d222e70b-ab8c-4a49-8d91-ba0ccc56c5c8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

