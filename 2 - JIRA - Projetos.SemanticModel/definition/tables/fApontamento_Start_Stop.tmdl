		annotation UnderlyingDateTimeDataType = Date

	column FiltroPeriodoOK = ```
			
			SWITCH(
			    TRUE(),
			
			    -- Últimos 7 dias (inclui hoje até 23:59:59)
			    fApontamento_Start_Stop[dataInicial] >= TODAY() - 7 
			        && fApontamento_Start_Stop[dataInicial] < TODAY() + 1, 
			    "Últimos 7 dias",
			
			    -- Últimos 30 dias (inclui os últimos 7 também)
			    fApontamento_Start_Stop[dataInicial] >= TODAY() - 30
			        && fApontamento_Start_Stop[dataInicial] < TODAY() + 1, 
			    "Últimos 30 dias",
			
			    -- Últimos 180 dias, excluindo os últimos 30
			    fApontamento_Start_Stop[dataInicial] >= TODAY() - 180 
			        && fApontamento_Start_Stop[dataInicial] < TODAY() - 30, 
			    "Últimos 180 dias",
			
			    "Outros"
			)
			
			```
		lineageTag: c47bc544-75e8-472d-990d-ad36bf7db453
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

