	column Versao_concatenado =
			
			CALCULATE (
			    CONCATENATEX (
			        VALUES('tbl_versao_corrigidas_jira'[Fix Version Name]),
			        'tbl_versao_corrigidas_jira'[Fix Version Name],
			        " ; "
			    ),
			    ALLEXCEPT('tbl_versao_corrigidas_jira', 'tbl_versao_corrigidas_jira'[Chave])
			)
		lineageTag: 3ad3329c-9963-425f-ab63-84d2c95b0b7d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Situacao_versao =
			
			SWITCH(
			    TRUE(),
			    'tbl_versao_corrigidas_jira'[Fix Version Archived] = "Não" && 'tbl_versao_corrigidas_jira'[Fix Version Released] = "Não", "Não Lançado",
			    'tbl_versao_corrigidas_jira'[Fix Version Archived] = "Não" && 'tbl_versao_corrigidas_jira'[Fix Version Released] = "Sim", "Lançado",
			    'tbl_versao_corrigidas_jira'[Fix Version Archived] = "Sim", "Arquivado")
		lineageTag: fcb17e00-26f0-46ac-a814-fb3cf1dccd04
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

