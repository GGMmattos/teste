	column Versão_e_situacao =
			
			COMBINEVALUES(" | Situação: ", tbl_versao_corrigidas_jira[Versão], tbl_versao_corrigidas_jira[Situacao_versao])
		lineageTag: a2a20b13-c5be-49ee-a121-8a30e47e6386
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Release_e_situacao =
			
			COMBINEVALUES(" | Situação: ", tbl_versao_corrigidas_jira[Release], tbl_versao_corrigidas_jira[Situacao_versao])
		lineageTag: 8a8857dc-f135-4620-8a08-335f4fb47ba3
