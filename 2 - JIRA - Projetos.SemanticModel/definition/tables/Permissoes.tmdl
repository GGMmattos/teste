	measure Rentabilidade_Bloqueado = ```
			
			VAR UsuarioLogado = USERPRINCIPALNAME()
			VAR Permissao = 
			    LOOKUPVALUE(
			        Permissoes[PodeVerValor],
			        Permissoes[Usuario],
			        UsuarioLogado
			    )
			VAR Resultado = 
			    CALCULATE(
			    AVERAGE(tbl_entregas_jira[Rentabilidade])) + 0
			RETURN
			IF(
			    Permissao = "Sim",
			    FORMAT(Resultado, "R$ #,##0.00"),   -- sempre texto
			    "Bloqueado"
			)
			```
