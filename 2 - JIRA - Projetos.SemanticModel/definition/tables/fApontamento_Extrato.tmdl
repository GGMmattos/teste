	column Filtro_desvio_realizado_com_e_sem = ```
			
			SWITCH(
			    TRUE(),
			    ISBLANK ( 'fApontamento_Extrato'[Desvio Real (Atual)] ), "Sem Desvio",
			    'fApontamento_Extrato'[Desvio Real (Atual)] > 0, "Com Desvio",
			    'fApontamento_Extrato'[Desvio Real (Atual)] <= 0, "Sem Desvio"
			)
			
			```
		lineageTag: 948651d2-bc8f-4147-bc87-d12679961359
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fApontamento_Extrato = m
		mode: import
		source =
				let
				    Fonte = Json.Document(
				    Web.Contents(
				        "https://service.sabium.com.br/api_controlehoras/controle-publico/orcamento/estimativa/pert/buscaLista",
				        [Timeout = #duration(0,0,5,0)]
				    )
				),
				    #"Convertido para Tabela" = Table.FromList(Fonte, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
				    #"Column1 Expandido" = Table.ExpandRecordColumn(#"Convertido para Tabela", "Column1", {"tarefaId", "chave", "projetoId", "percentualConcluido", "hrRealizada", "hrsPrevistas", "hrsProjetadas"}, {"tarefaId", "chave", "projetoId", "percentualConcluido", "hrRealizada", "hrsPrevistas", "hrsProjetadas"}),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Column1 Expandido",{{"tarefaId", Int64.Type}, {"chave", type text}, {"projetoId", Int64.Type}, {"percentualConcluido", Int64.Type}, {"hrRealizada", type number}, {"hrsPrevistas", type number}, {"hrsProjetadas", type number}}),
				    #"Linhas Filtradas" = Table.SelectRows(#"Tipo Alterado", each not Text.StartsWith([chave], "APPGES")),
				    #"Coluna Condicional Adicionada" = Table.AddColumn(#"Linhas Filtradas", "Status_horas_previstas", each if [hrsPrevistas] > 0 then "Com Estimativa" else "Sem Estimativa")
				in
				    #"Coluna Condicional Adicionada"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

